// ABOUTME: Defines the isolated CROFusion-branded OPAS demo Worker and D1 database.
// ABOUTME: Routes only demo-cro.opas.dev and leaves CROFusion production resources untouched.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opas-demo-cro",
  "main": "custom-worker.ts",
  "account_id": "f8801c7e8853a113a25f8b52fd9ceec1",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "demo-cro.opas.dev",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": [
      "ADMIN_SESSION_SECRET",
      "OPAS_PREVIEW_SIGNING_SECRET",
      "OPAS_HANDOFF_TO_EMAIL"
    ]
  },
  "send_email": [
    {
      "name": "SUPPORT_EMAIL",
      "allowed_sender_addresses": ["hello@opas.dev"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "15 0 * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "opas-demo-cro"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "OPAS_DATABASE_DRIVER": "d1",
    "OPAS_ANSWER_DAILY_BUDGET_MICRODOLLARS": "1000000",
    "OPAS_ANSWER_ANALYTICS_RETENTION_DAYS": "30",
    "OPAS_ANSWER_INPUT_MICRODOLLARS_PER_MILLION_TOKENS": "152000",
    "OPAS_ANSWER_LEASE_MILLISECONDS": "45000",
    "OPAS_ANSWER_MAXIMUM_CONCURRENCY": "4",
    "OPAS_ANSWER_MAXIMUM_INPUT_TOKENS": "32000",
    "OPAS_ANSWER_OUTPUT_MICRODOLLARS_PER_MILLION_TOKENS": "287000",
    "OPAS_GENERATION_GATEWAY_ID": "opas-answers",
    "OPAS_GENERATION_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "OPAS_GENERATION_RETENTION_DISCLOSURE": "Answer analytics retain configured redacted conversation records for up to 30 days; explicit support handoffs retain contact and bounded context separately. Cloudflare AI Gateway logging is disabled and response caching is bypassed.",
    "OPAS_ANALYTICS_REDACTION_PATTERNS": "[]",
    "OPAS_EMBED_PARENT_ORIGINS": "https://crofusion.com,https://crofusion.net",
    "OPAS_HANDOFF_DAILY_LIMIT": "100",
    "OPAS_HANDOFF_FROM_EMAIL": "hello@opas.dev",
    "OPAS_HANDOFF_PROVIDER": "cloudflare-email",
    "OPAS_HANDOFF_RETENTION_DAYS": "30",
    "OPAS_PUBLIC_PROFILE": "crofusion",
    "OPAS_SITE_URL": "https://demo-cro.opas.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opas-demo-cro",
      "database_id": "4ae0a2a0-c0f8-4623-86cd-ef787375092b",
      "preview_database_id": "DB",
      "migrations_dir": "drizzle/sqlite"
    }
  ],
  "observability": {
    "enabled": true
  }
}
