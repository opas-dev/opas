// ABOUTME: Configures a disposable Wrangler-local Worker for saved-quality authorization tests.
// ABOUTME: Uses isolated local D1 state and never addresses a remote database.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "opas-quality-authoring-test",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opas-quality-authoring-test",
      "database_id": "00000000-0000-0000-0000-000000000009",
      "preview_database_id": "DB",
      "migrations_dir": "../../../drizzle/sqlite"
    }
  ]
}
