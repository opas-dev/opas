{
  "name": "opas",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "test": "pnpm lint && pnpm typecheck && pnpm test:analytics && pnpm test:auth && pnpm test:content && pnpm test:deployment && pnpm test:mdx && pnpm test:seo && pnpm test:search && pnpm test:theme && pnpm test:repositories",
    "test:analytics": "tsx --test tests/analytics.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:content": "tsx --test tests/content-admin-validation.test.ts",
    "test:deployment": "tsx --test tests/cloudflare-bootstrap.test.ts tests/security-headers.test.ts",
    "test:mdx": "tsx --test tests/mdx-safety.test.ts",
    "test:seo": "tsx --test tests/seo.test.ts",
    "test:search": "tsx --test tests/search.test.ts",
    "test:repositories": "tsx --test --test-concurrency=1 tests/repository.integration.test.ts",
    "test:theme": "tsx --test tests/theme.test.ts",
    "build:prepare:postgres": "esbuild scripts/prepare-postgres.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=.next/standalone/prepare-postgres.cjs",
    "cf:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap-cloudflare.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:seed": "wrangler d1 execute DB --remote --file scripts/seed-d1.sql --yes",
    "cf:types": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:migrate:postgres": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:seed:postgres": "node --env-file=.env --import tsx scripts/seed-postgres.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply opas-mvp --local",
    "db:seed:d1:local": "wrangler d1 execute opas-mvp --local --file scripts/seed-d1.sql",
    "neon:prepare": "node --env-file=.env --import tsx scripts/prepare-neon.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "1.5.1",
    "@neondatabase/serverless": "1.1.0",
    "@orama/orama": "3.1.18",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "4.0.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "@opennextjs/cloudflare": "1.20.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "wrangler": "4.127.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
