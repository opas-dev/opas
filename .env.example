# ABOUTME: Template for the single .env that configures every OPAS deploy target.
# ABOUTME: Copy to .env (gitignored) and fill in what the current target needs.

# Docker / local: bundled Postgres
DATABASE_URL=postgres://opas:opas@localhost:5432/opas
POSTGRES_DB=opas
POSTGRES_USER=opas
POSTGRES_PASSWORD=opas
POSTGRES_PORT=5432
APP_PORT=3000
# Required public origin; keep its port aligned with APP_PORT.
OPAS_SITE_URL=http://localhost:3000

# Vercel target: Neon Postgres connection string
NEON_DATABASE_URL=

# Vercel CLI deploys (or run `vercel login` instead)
VERCEL_TOKEN=

# Required admin login (password: 8+ characters; session secret: 32+ bytes)
ADMIN_EMAIL=admin@opas.dev
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Docker and Vercel: private scheduled-recovery credential (32+ random bytes)
CRON_SECRET=

# Docker and Vercel: OpenAI-compatible streaming answer provider
OPAS_GENERATION_ENDPOINT=
OPAS_GENERATION_MODEL=
# Required browser-visible statement of product and provider retention behavior.
OPAS_GENERATION_RETENTION_DISCLOSURE=
OPAS_GENERATION_API_KEY=

# Optional strict JSON topic policy; blank means no deployment-specific topic policy.
OPAS_ANSWER_TOPIC_GUARDRAILS=

# Docker and Vercel: OpenAI-compatible embedding provider
OPAS_EMBEDDING_ENDPOINT=
OPAS_EMBEDDING_MODEL=
OPAS_EMBEDDING_DIMENSION=
OPAS_EMBEDDING_DIMENSIONS_PARAMETER=false
OPAS_EMBEDDING_API_KEY=
# Docker recovery interval; the default keeps activation below one minute.
OPAS_EMBEDDING_RECOVERY_INTERVAL_MS=30000

# Cloudflare: Wrangler supplies Workers AI generation and embeddings through AI.
