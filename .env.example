# ABOUTME: Template for the single .env that configures every OPAS deploy target.
# ABOUTME: Copy to .env (gitignored) and fill in what the current target needs.

# Docker / local: bundled Postgres
DATABASE_URL=postgres://opas:opas@localhost:5432/opas
POSTGRES_DB=opas
POSTGRES_USER=opas
POSTGRES_PASSWORD=opas
POSTGRES_PORT=5432
APP_PORT=3000
# Required public origin; keep its port aligned with APP_PORT.
OPAS_SITE_URL=http://localhost:3000
# Exact comma-separated origins allowed to embed /embed; blank keeps it unframeable.
OPAS_EMBED_PARENT_ORIGINS=

# Vercel target: Neon Postgres connection string
NEON_DATABASE_URL=
# Optional local override; otherwise tooling derives the matching direct Neon host in memory.
NEON_DIRECT_DATABASE_URL=

# Vercel CLI deploys (or run `vercel login` instead)
VERCEL_TOKEN=

# Required admin login (password: 8+ characters; session secret: 32+ bytes)
ADMIN_EMAIL=admin@opas.dev
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Docker and Vercel: required private cleanup/recovery credential (32+ random bytes)
CRON_SECRET=

# Docker and Vercel: OpenAI-compatible streaming answer provider
OPAS_GENERATION_ENDPOINT=
OPAS_GENERATION_MODEL=
# Required browser-visible statement of product and provider retention behavior.
OPAS_GENERATION_RETENTION_DISCLOSURE=
OPAS_GENERATION_API_KEY=

# Optional cross-provider generation fallback. It remains off unless this exact
# opt-in is true. Configure every field and disclose the second vendor/model.
OPAS_GENERATION_FALLBACK_ENABLED=false
OPAS_GENERATION_FALLBACK_PROVIDER=
OPAS_GENERATION_FALLBACK_ENDPOINT=
OPAS_GENERATION_FALLBACK_GATEWAY_ID=
OPAS_GENERATION_FALLBACK_MODEL=
OPAS_GENERATION_FALLBACK_RETENTION_DISCLOSURE=
OPAS_GENERATION_FALLBACK_API_KEY=

# Optional strict JSON topic policy; blank means no deployment-specific topic policy.
OPAS_ANSWER_TOPIC_GUARDRAILS=

# Required to activate answers: strict base-10 integers with no whitespace.
# Prices are integer microdollars per one million provider-reported tokens.
OPAS_ANSWER_MAXIMUM_CONCURRENCY=
OPAS_ANSWER_DAILY_BUDGET_MICRODOLLARS=
OPAS_ANSWER_MAXIMUM_INPUT_TOKENS=
OPAS_ANSWER_INPUT_MICRODOLLARS_PER_MILLION_TOKENS=
OPAS_ANSWER_OUTPUT_MICRODOLLARS_PER_MILLION_TOKENS=
# Required with fallback opt-in; one reservation covers both provider attempts.
OPAS_ANSWER_FALLBACK_INPUT_MICRODOLLARS_PER_MILLION_TOKENS=
OPAS_ANSWER_FALLBACK_OUTPUT_MICRODOLLARS_PER_MILLION_TOKENS=
# Fallback requires at least 65000 so both bounded provider attempts fit one lease.
OPAS_ANSWER_LEASE_MILLISECONDS=45000

# Privacy retention and public-write limits. Analytics can be shortened or disabled
# with 0; explicit support handoffs retain separately for 1 to 365 days.
OPAS_ANSWER_ANALYTICS_RETENTION_DAYS=30
OPAS_ANALYTICS_REDACTION_PATTERNS=[]
OPAS_HANDOFF_DAILY_LIMIT=100
OPAS_HANDOFF_RETENTION_DAYS=30

# Support handoff: choose cloudflare-rest-email or webhook on Docker/Vercel.
# Cloudflare Workers uses cloudflare-email from wrangler.jsonc and needs only
# OPAS_HANDOFF_TO_EMAIL here so the guarded bootstrap can upload it as a secret.
OPAS_HANDOFF_PROVIDER=
OPAS_HANDOFF_FROM_EMAIL=hello@opas.dev
OPAS_HANDOFF_TO_EMAIL=
OPAS_HANDOFF_CLOUDFLARE_ACCOUNT_ID=
OPAS_HANDOFF_CLOUDFLARE_API_TOKEN=
OPAS_HANDOFF_WEBHOOK_URL=
OPAS_HANDOFF_WEBHOOK_TOKEN=

# Docker and Vercel: OpenAI-compatible embedding provider
OPAS_EMBEDDING_ENDPOINT=
OPAS_EMBEDDING_MODEL=
OPAS_EMBEDDING_DIMENSION=
OPAS_EMBEDDING_DIMENSIONS_PARAMETER=false
OPAS_EMBEDDING_API_KEY=
# Docker recovery interval; the default keeps activation below one minute.
OPAS_EMBEDDING_RECOVERY_INTERVAL_MS=30000
OPAS_ANALYTICS_CLEANUP_INTERVAL_MS=21600000

# Cloudflare: Wrangler supplies Workers AI generation and embeddings through AI.

# Optional authenticated provider benchmark inputs for `pnpm evaluate:retrieval`.
# Supply current prices explicitly; the report never guesses a vendor price.
OPAS_EVALUATION_CLOUDFLARE_ACCOUNT_ID=
OPAS_EVALUATION_CLOUDFLARE_API_TOKEN=
OPAS_EVALUATION_WORKERS_AI_INPUT_USD_PER_MILLION_TOKENS=
OPAS_EVALUATION_OPENAI_INPUT_USD_PER_MILLION_TOKENS=
# Optional AI Search staging instance. The JSON object maps every fixture source
# ID to its exact indexed item key; the instance name must start with opas-.
OPAS_EVALUATION_AI_SEARCH_INSTANCE=
OPAS_EVALUATION_AI_SEARCH_SOURCE_KEYS=
OPAS_EVALUATION_AI_SEARCH_COST_USD_PER_QUERY=
